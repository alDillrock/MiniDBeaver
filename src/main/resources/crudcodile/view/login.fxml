<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="crudcodile.controller.LoginController"
            styleClass="root-dark">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
            <children>
                <VBox alignment="CENTER" styleClass="logo-box">
                    <Label text="C" styleClass="logo-letter" />
                </VBox>
                <VBox spacing="2">
                    <Label text="CRUDCODILE" styleClass="brand-title" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
            <padding>
                <Insets top="22" right="34" bottom="18" left="34" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <children>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="CONEXION AL SERVIDOR" styleClass="screen-title" />
                    <Label text="Ingresa los datos SSH y las credenciales de MariaDB para acceder a its5a."
                           styleClass="muted-text" />
                </VBox>

                <GridPane hgap="20" maxWidth="900">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS" />
                    </columnConstraints>

                    <VBox spacing="11" styleClass="card" GridPane.columnIndex="0">
                        <children>
                            <Label text="ACCESO SSH" styleClass="card-title" />
                            <Label text="Servidor que recibira la sesion SSH" styleClass="muted-small" />

                            <Label text="Host SSH" styleClass="field-label" />
                            <TextField fx:id="fieldSshHost" promptText="ej. servidor.midominio.com" />

                            <HBox spacing="12">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Puerto" styleClass="field-label" />
                                    <TextField fx:id="fieldSshPort" />
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Usuario" styleClass="field-label" />
                                    <TextField fx:id="fieldSshUsuario" />
                                </VBox>
                            </HBox>

                            <Label text="Contraseña SSH" styleClass="field-label" />
                            <PasswordField fx:id="fieldSshPassword" />
                        </children>
                    </VBox>

                    <VBox spacing="11" styleClass="card" GridPane.columnIndex="1">
                        <children>
                            <Label text="MARIADB / its5a" styleClass="card-title" />
                            <Label text="Destino alcanzado a traves del tunel" styleClass="muted-small" />

                            <Label text="Host MariaDB" styleClass="field-label" />
                            <TextField fx:id="fieldDbHost" />

                            <HBox spacing="12">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Puerto" styleClass="field-label" />
                                    <TextField fx:id="fieldDbPort" />
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Usuario" styleClass="field-label" />
                                    <TextField fx:id="fieldDbUsuario" />
                                </VBox>
                            </HBox>

                            <Label text="Contraseña MariaDB" styleClass="field-label" />
                            <PasswordField fx:id="fieldDbPassword" />
                        </children>
                    </VBox>
                </GridPane>
            </children>
            <padding>
                <Insets top="24" right="40" bottom="20" left="40" />
            </padding>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="18" styleClass="bottom-bar">
            <children>
                <Button text="Integrantes"
                        onAction="#mostrarIntegrantes"
                        styleClass="button-secondary" />
                <Button fx:id="botonAccesoLocal"
                        text="ABRIR BASE LOCAL"
                        onAction="#abrirBaseLocal"
                        styleClass="button-secondary" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelEstado" styleClass="status-text" />
                <Button fx:id="botonConectar"
                        text="CONECTAR"
                        onAction="#conectar"
                        defaultButton="true"
                        styleClass="button-primary" />
            </children>
            <padding>
                <Insets top="16" right="34" bottom="20" left="34" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
